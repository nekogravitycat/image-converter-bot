# Copy to .env and fill in. Never commit .env.
DISCORD_BOT_TOKEN=

LOG_LEVEL=info

WORKER_COUNT=2
WORK_QUEUE_SIZE=32

# 50 MiB
MAX_INPUT_FILE_SIZE=52428800
# ~100 megapixels
MAX_INPUT_PIXELS=100000000

# Optional: register slash commands to a single server for instant updates while developing.
# Leave empty in production to register global commands.
DISCORD_DEV_GUILD_ID=
